<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="5dp"/>
            <gradient
                android:startColor="#b4ddbd"
                android:endColor="#b4ddbd"
                android:angle="270"
                android:centerY="0.75"
                android:centerColor="#b4ddbd"/>
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="5dp"/>
                <gradient
                    android:startColor="#2ab24b"
                    android:endColor="#2ab24b"
                    android:angle="270"
                    android:centerY="0.75"
                    android:centerColor="#2ab24b"/>
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="5dp"/>
                <gradient
                    android:startColor="#2ab24b"
                    android:endColor="#2ab24b"
                    android:angle="270"
                    android:centerY="0.75"
                    android:centerColor="#2ab24b"/>
            </shape>
        </clip>
    </item>
</layer-list>
