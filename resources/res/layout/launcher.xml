<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.LauncherRootView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcher"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_wallpaper"
        android:background="@android:color/holo_orange_dark"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/bg_default_wallpaper_bitmap"
        android:scaleType="centerCrop"
        launcher:layout_ignoreInsets="true"/>
    <com.android.launcher3.dragndrop.DragLayer
        android:id="@+id/drag_layer"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no">
        <com.android.launcher3.Workspace
            android:theme="@style/HomeScreenElementTheme"
            android:layout_gravity="center"
            android:id="@+id/workspace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            launcher:pageIndicator="@+id/page_indicator"/>
        <include
            android:id="@+id/overview_panel_container"
            android:visibility="gone"
            layout="@layout/overview_panel"/>
        <com.android.launcher3.pageindicators.WorkspacePageIndicator
            android:theme="@style/HomeScreenElementTheme"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/page_indicator"
            android:layout_width="match_parent"
            android:layout_height="4dp"/>
        <include
            android:id="@+id/drop_target_bar"
            layout="@layout/drop_target_bar"/>
        <include
            android:id="@+id/scrim_view"
            layout="@layout/scrim_view"/>
        <include
            android:id="@+id/apps_view"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/all_apps"/>
        <include
            android:id="@+id/hotseat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/hotseat"/>
    </com.android.launcher3.dragndrop.DragLayer>
    <ImageView
        android:id="@+id/v_mask"
        android:background="@drawable/bg_activity_default"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="center"
        launcher:layout_ignoreInsets="true"/>
</com.android.launcher3.LauncherRootView>
