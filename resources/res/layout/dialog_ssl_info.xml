<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="?android:attr/textAppearanceListItemSmall"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ssl_info_issued_by"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceListItemSmall"
            android:id="@+id/ssl_layout_issue_by"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/material_grid_unit"
            android:paddingStart="@dimen/material_grid_unit"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceListItemSmall"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/material_grid_margin"
            android:text="@string/ssl_info_issued_to"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceListItemSmall"
            android:id="@+id/ssl_layout_issue_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/material_grid_unit"
            android:paddingStart="@dimen/material_grid_unit"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceListItemSmall"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/material_grid_margin"
            android:text="@string/ssl_info_issued_on"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceListItemSmall"
            android:id="@+id/ssl_layout_issue_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/material_grid_unit"
            android:paddingStart="@dimen/material_grid_unit"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceListItemSmall"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/material_grid_margin"
            android:text="@string/ssl_info_expires_on"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceListItemSmall"
            android:id="@+id/ssl_layout_expire_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/material_grid_unit"
            android:paddingStart="@dimen/material_grid_unit"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceListItemSmall"
            android:textStyle="bold"
            android:id="@+id/algorithm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/material_grid_margin"
            android:text="@string/algorithm"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceListItemSmall"
            android:id="@+id/ssl_layout_serial_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/material_grid_unit"
            android:paddingStart="@dimen/material_grid_unit"/>
    </LinearLayout>
</ScrollView>
