<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:background="#f2f2f2"
        android:layout_width="match_parent"
        android:layout_height="36dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/abc_ic_ab_back_material"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#202020"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_grant_complex_step4_title"/>
    </LinearLayout>
    <FrameLayout
        android:background="#f2f2f2"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="9dp"
                app:cardCornerRadius="8dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/cv_app_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:gravity="start"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="11sp"
                    android:textColor="#202020"
                    android:id="@+id/text_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="dddddd"/>
                <TextView
                    android:textSize="9sp"
                    android:textColor="#999999"
                    android:id="@+id/text_app_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_grant_complex_app_sub_title"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:textSize="9sp"
        android:textColor="#444444"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:text="@string/guide_grant_complex_step4_options_title"
        android:textAllCaps="true"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_focus"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="22dp"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="38dp">
        <RadioButton
            android:id="@+id/radio_focus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:checked="true"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#202020"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_grant_complex_step4_option_1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="22dp"
        android:layout_width="match_parent"
        android:layout_height="38dp">
        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:checked="false"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#202020"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_grant_complex_step4_option_2"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="22dp"
        android:layout_width="match_parent"
        android:layout_height="38dp">
        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:checked="false"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#202020"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_grant_complex_step4_option_3"/>
    </LinearLayout>
</LinearLayout>
