<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#fbfbfb"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="enterAlways|scroll"
            app:title="@string/action_data_setting"
            app:titleTextColor="#ffffff"/>
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="31dp"
        android:layout_marginRight="31dp"
        android:layout_marginBottom="58dp"
        android:layout_marginHorizontal="31dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <Button
            android:enabled="true"
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/bt_scan"
            android:background="@drawable/bt_green_gray"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/btn_start_scan"
            android:textAllCaps="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_current"
        android:background="@drawable/round_rect_mint15"
        android:paddingLeft="28dp"
        android:paddingTop="18dp"
        android:paddingRight="28dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="23dp"
        android:layout_marginRight="15dp"
        android:layout_marginHorizontal="15dp"
        android:paddingHorizontal="28dp"
        android:paddingVertical="18dp"
        app:layout_constraintTop_toBottomOf="@+id/app_bar">
        <TextView
            android:textSize="17sp"
            android:textColor="#202020"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_current_data_location"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#444444"
            android:id="@+id/tv_current_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/desc_current_data_locations"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#444444"
            android:id="@+id/tv_current_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/round_rect_gray15"
        android:padding="18dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="25dp"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_bottom"
        app:layout_constraintTop_toBottomOf="@+id/ll_current">
        <TextView
            android:textSize="17sp"
            android:textColor="#202020"
            android:id="@+id/tv_scan_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_existed_data_locations"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/fl_scan"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_scan_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
