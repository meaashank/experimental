<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:background="#f2f2f2"
        android:layout_width="match_parent"
        android:layout_height="36dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/abc_ic_ab_back_material"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#202020"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_grant_complex_step2_title"/>
    </LinearLayout>
    <FrameLayout
        android:background="#f2f2f2"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="9dp"
                app:cardCornerRadius="8dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/cv_app_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:gravity="start"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="11sp"
                    android:textColor="#202020"
                    android:id="@+id/text_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="dddddd"/>
                <TextView
                    android:textSize="9sp"
                    android:textColor="#999999"
                    android:id="@+id/text_app_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_grant_complex_app_sub_title"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:paddingLeft="25dp"
        android:layout_width="match_parent"
        android:layout_height="43dp">
        <androidx.cardview.widget.CardView
            android:layout_width="45dp"
            android:layout_height="8dp"
            android:layout_marginBottom="3dp"
            android:foreground="#dadada"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"/>
        <androidx.cardview.widget.CardView
            android:layout_width="67dp"
            android:layout_height="7dp"
            android:foreground="#e6e6e6"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:id="@+id/llFocus"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="31dp"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="74dp">
        <TextView
            android:textSize="18sp"
            android:textColor="#202020"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/guide_grant_complex_step2_button_title"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_grant_complex_step2_button_sub_title"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:paddingLeft="25dp"
        android:layout_width="match_parent"
        android:layout_height="43dp">
        <androidx.cardview.widget.CardView
            android:layout_width="45dp"
            android:layout_height="8dp"
            android:layout_marginBottom="3dp"
            android:foreground="#dadada"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"/>
        <androidx.cardview.widget.CardView
            android:layout_width="67dp"
            android:layout_height="7dp"
            android:foreground="#e6e6e6"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:paddingLeft="25dp"
        android:layout_width="match_parent"
        android:layout_height="43dp">
        <androidx.cardview.widget.CardView
            android:layout_width="45dp"
            android:layout_height="8dp"
            android:layout_marginBottom="3dp"
            android:foreground="#dadada"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"/>
        <androidx.cardview.widget.CardView
            android:layout_width="67dp"
            android:layout_height="7dp"
            android:foreground="#e6e6e6"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"/>
    </LinearLayout>
</LinearLayout>
