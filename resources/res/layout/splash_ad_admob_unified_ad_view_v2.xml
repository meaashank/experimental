<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:background="@color/nativeAdBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/nativeAdSkip"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/close"
            android:scaleType="centerCrop"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/nativeAdSkipBig"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/close"
            android:scaleType="centerCrop"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <com.prism.fusionadsdkbase.widget.CircleProgressBar
            android:gravity="center"
            android:id="@+id/cpb_progress"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <RelativeLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/nativeAdHeadView"
            android:background="@android:color/transparent"
            android:paddingBottom="25dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="65dp">
            <ImageView
                android:id="@+id/nativeAdIcon"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginLeft="24dp"
                android:layout_alignParentLeft="true"
                android:contentDescription="TODO"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_toRightOf="@+id/nativeAdIcon">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/nativeAdTitle"
                    android:gravity="left"
                    android:id="@+id/nativeAdTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/five_star_yellow"
                    android:scaleType="centerCrop"/>
            </LinearLayout>
        </RelativeLayout>
        <com.prism.fusionadsdkbase.widget.RatioFrameLayout
            android:id="@+id/mediaView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_below="@+id/nativeAdHeadView"
            app:layout_ratio="1.69">
            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/nativeAdMedia"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"/>
        </com.prism.fusionadsdkbase.widget.RatioFrameLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/nativeAdBodyView"
            android:paddingTop="24dp"
            android:paddingBottom="25dp"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/mediaView"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="14sp"
                android:textColor="#999999"
                android:gravity="center"
                android:id="@+id/nativeAdBody"
                android:paddingTop="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="27dp"
                android:layout_marginRight="27dp"
                android:maxLines="4"
                android:layout_below="@+id/nativeAdStarRating"/>
            <Button
                android:textColor="@android:color/white"
                android:id="@+id/nativeAdCallToAction"
                android:background="@drawable/btn_native_call_to_action"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginBottom="16dp"
                android:layout_above="@+id/view_none"/>
            <View
                android:id="@+id/view_none"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:background="@drawable/mc_bg_ads_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="AD"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
