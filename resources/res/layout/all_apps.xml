<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.allapps.AllAppsContainerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/apps_view"
    android:focusable="false"
    android:saveEnabled="false"
    android:clipChildren="true"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/all_apps_rv_layout"/>
    <include layout="@layout/all_apps_floating_header"/>
    <include
        android:id="@+id/search_container_all_apps"
        layout="@layout/search_container_all_apps"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/all_apps_footer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="16sp"
            android:textColor="#ff3c42"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/ext_all_apps_not_find_app"/>
    </LinearLayout>
    <include layout="@layout/all_apps_fast_scroller"/>
    <include
        android:id="@+id/all_apps_extension"
        layout="@layout/all_apps_extension"/>
</com.android.launcher3.allapps.AllAppsContainerView>
