<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <TextView
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:id="@+id/account_rm_where"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/hider_guest_remove_bg"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#c0392b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/accounts_remove_gone_head"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:id="@+id/account_rm_gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/hider_guest_strip_bg"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1ea25a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/accounts_remove_stays_head"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:id="@+id/account_rm_stays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.3"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:id="@+id/account_rm_note"
            android:background="@drawable/hider_guest_note_bg"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.3"/>
    </LinearLayout>
</ScrollView>
