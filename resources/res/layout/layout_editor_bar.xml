<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:id="@+id/edit_action_btns"
    android:background="?attr/galleryActionModeBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/share_media"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:tint="@color/action_mode_text_color"
            app:srcCompat="@drawable/ic_share_grey"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/action_mode_text_color"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_text_preview_share"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/export_media"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:tint="@color/action_mode_text_color"
            app:srcCompat="@drawable/ic_export_grey"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/action_mode_text_color"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_text_preview_export"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/move_media"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:tint="@color/action_mode_text_color"
            app:srcCompat="@drawable/ic_move_grey"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/action_mode_text_color"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_text_preview_move"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/delete_media"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:tint="@color/action_mode_text_color"
            app:srcCompat="@drawable/ic_delete_grey"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/action_mode_text_color"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_text_preview_delete"/>
    </LinearLayout>
</LinearLayout>
