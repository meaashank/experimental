<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/tab_item_background"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:clickable="false"
    android:layout_width="@dimen/desktop_tab_width"
    android:layout_height="match_parent"
    android:weightSum="1">
    <FrameLayout
        android:id="@+id/favicon_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/faviconTab"
            android:layout_width="@dimen/material_grid_small_icon"
            android:layout_height="@dimen/material_grid_small_icon"
            android:layout_marginLeft="4dp"
            android:contentDescription="@null"
            android:layout_marginEnd="4dp"/>
    </FrameLayout>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/textTab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?android:attr/listPreferredItemHeightSmall"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_weight="1"
        android:fontFamily="sans-serif"/>
    <FrameLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/deleteAction"
        android:background="?attr/actionBarItemBackground"
        android:layout_width="@dimen/material_grid_touch_small"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/deleteButton"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/close_tab"
            app:srcCompat="@drawable/ic_action_delete"/>
    </FrameLayout>
</LinearLayout>
