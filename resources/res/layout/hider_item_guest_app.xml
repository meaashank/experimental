<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">
        <ImageView
            android:id="@+id/guest_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"/>
        <View
            android:layout_gravity="end|bottom"
            android:id="@+id/guest_running_dot"
            android:background="@drawable/hider_guest_running_dot"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:ellipsize="end"
                android:id="@+id/guest_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#5b6170"
                android:id="@+id/guest_off_chip"
                android:background="@drawable/hider_guest_chip_bg"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guest_apps_chip_off"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:ellipsize="start"
                android:id="@+id/guest_pkg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@+id/guest_vuser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="end"
        android:id="@+id/guest_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="58dp"
        android:layout_marginStart="12dp"/>
    <ImageView
        android:layout_width="8dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_detail_more"
        android:contentDescription="@null"
        android:layout_marginStart="24dp"/>
</LinearLayout>
