<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_apk_ad_interstitial_root"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/ad_media_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ad_info_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_ad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="false"
            android:contentDescription="@string/hider_ad_tag"/>
        <WebView
            android:id="@+id/wv_ad_html"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageButton
            android:layout_gravity="end|bottom"
            android:id="@+id/btn_media_sound"
            android:background="@drawable/bg_apk_ad_close_button"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginBottom="16dp"
            android:src="@android:drawable/ic_lock_silent_mode"
            android:scaleType="centerInside"
            android:contentDescription="@string/apk_ad_sound_button"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <View
        android:id="@+id/media_bottom_scrim"
        android:background="@drawable/bg_apk_ad_media_scrim"
        android:layout_width="0dp"
        android:layout_height="112dp"
        app:layout_constraintBottom_toTopOf="@+id/ad_info_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/tv_ad_tag"
        android:background="@drawable/bg_apk_ad_tag"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="16dp"
        android:minWidth="44dp"
        android:text="@string/hider_ad_tag"
        android:includeFontPadding="false"
        android:textAllCaps="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/btn_close"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="14dp"
        android:onClick="onCloseClick"
        android:contentDescription="@string/bottom_work_tab_user_education_close_button"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="20sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:background="@drawable/bg_apk_ad_close_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="×"
            android:includeFontPadding="false"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ad_info_panel"
        android:background="@drawable/bg_apk_ad_bottom_panel"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:background="@drawable/bg_apk_ad_icon_plate"
                android:padding="6dp"
                android:layout_width="68dp"
                android:layout_height="68dp">
                <ImageView
                    android:id="@+id/iv_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp">
                <TextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#ff16181d"
                    android:ellipsize="end"
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff5f6673"
                    android:ellipsize="end"
                    android:id="@+id/tv_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:maxLines="2"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/cta_container"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp">
            <ProgressBar
                android:id="@+id/pb_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="100"
                android:indeterminate="false"
                android:indeterminateOnly="false"
                android:progressDrawable="@drawable/hider_apk_ad_cta_progress"
                android:minHeight="56dp"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/tv_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/apk_ad_bt_install"
                android:includeFontPadding="false"
                android:onClick="onClick"
                android:textAllCaps="false"/>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
