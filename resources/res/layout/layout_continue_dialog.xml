<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_continue_dialog"
    android:layout_width="270dp"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_popup"
        android:layout_width="270dp"
        android:layout_height="228dp">
        <ImageView
            android:id="@+id/bt_continue_close"
            android:clickable="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="5dp"
            android:src="@drawable/ic_close_popup"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="22sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_keyword_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="42dp"
            android:layout_marginTop="42dp"
            android:text="Title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="44sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_keyword_content"
            android:layout_width="186dp"
            android:layout_height="144dp"
            android:layout_marginLeft="42dp"
            android:text="Keyword"
            android:fontFamily="Roboto Medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="22sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_mesg_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="24dp"
        android:text="Mesg Title"
        android:fontFamily="Roboto Medium"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#303030"
        android:gravity="left"
        android:layout_gravity="center"
        android:id="@+id/tv_mesg_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="asdfadfadfasdfasdfasdfasdfasdfasfdfsdffdfsdfsdf"
        android:fontFamily="Roboto Regular"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_not_next_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="8dp">
        <CheckBox
            android:id="@+id/cb_not_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#999999"
            android:id="@+id/tv_not_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="adfasdfadf"
            android:fontFamily="Roboto Regular"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/bt_continue"
            android:background="#34a853"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/text_continue"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
