<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_top_bts"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="16sp"
            android:textColor="#1ea25a"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_cancel_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:text="@string/cancel"
            android:layout_weight="1"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_selected_imgssss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/edit_activity_selected_info_title"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="#1ea25a"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:text="@string/edit_activity_select_all_files"
            android:layout_weight="1"/>
    </LinearLayout>
    <in.myinnos.alphabetsindexfastscrollrecycler.IndexFastScrollRecyclerView
        android:id="@+id/rv_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_bottom_bts"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_top_bts"
        app:setIndexbarMargin="0"
        app:setIndexbarWidth="15"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_bottom_bts"
        android:background="@drawable/bg_browerhost_gallery_bt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <CheckBox
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_gravity="start"
            android:id="@+id/chk_delete_src"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="22dp"
            android:layout_marginRight="18dp"
            android:layout_marginBottom="12dp"
            android:checked="true"
            android:text="@string/import_chk_delete_src"
            android:buttonTint="@color/checkbox_color"/>
        <Button
            android:textSize="15sp"
            android:textColor="@color/comfirm_import_bt_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/confirm_choice"
            android:background="@drawable/bg_start_import_bt"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:layout_marginBottom="14dp"
            android:text="@string/import_no_slct_title"
            android:textAllCaps="true"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
