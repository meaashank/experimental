<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_back"
                android:clickable="true"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="24dp"
                android:src="@drawable/ic_gaia_back"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/rl_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/app_bar_layout"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/iv_guest_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_guest_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="#222222"
            android:id="@+id/tv_permission_decs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="28dp"
            android:layout_marginRight="18dp"
            android:text="@string/permission_need_dialog_text"
            android:layout_below="@+id/rl_title"/>
        <ListView
            android:id="@+id/lv_permissions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="24dp"
            android:divider="@null"
            android:layout_above="@+id/tv_click_apply"
            android:layout_below="@+id/tv_permission_decs"/>
        <TextView
            android:textSize="17sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tv_click_apply"
            android:background="@drawable/shape_apply_permission_bg"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:layout_marginBottom="46dp"
            android:text="@string/to_grant"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</FrameLayout>
