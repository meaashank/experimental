<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="?attr/selectableItemBackground">
    <ImageView
        android:id="@+id/iv_gallery_content_image"
        android:padding="1dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <TextView
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:id="@+id/tv_duration"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:drawableLeft="@drawable/ic_gallery_video_flag_backgroud"
        android:layout_alignParentBottom="true"
        android:drawableStart="@drawable/ic_gallery_video_flag_backgroud"/>
    <androidx.core.widget.ContentLoadingProgressBar
        android:id="@+id/pb_syncing"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:indeterminateTint="@android:color/white"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_synced"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@drawable/ic_cloud_synced"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <ImageView
        android:gravity="center"
        android:id="@+id/cover_area_selected"
        android:background="?attr/colorMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="center"
        app:srcCompat="@drawable/ic_check"/>
</RelativeLayout>
