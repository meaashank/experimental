<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/internal_root_folder"
    android:layout_width="match_parent"
    android:layout_height="86dp">
    <RelativeLayout
        android:id="@+id/img_layer_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">
        <ImageView
            android:id="@+id/iv_album_folder_cover"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@mipmap/gallery_empty_folder"/>
        <TextView
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/tv_duration_folder_cover"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawableLeft="@drawable/ic_video_folder_flag_bg"
            android:layout_centerInParent="true"
            android:drawableStart="@drawable/ic_video_folder_flag_bg"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/album_folder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_toRightOf="@+id/img_layer_1"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="15sp"
            android:textColor="#222222"
            android:id="@+id/tv_album_folder_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/internal_storage"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#808080"
            android:id="@+id/tv_album_folder_stat_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_next_detail"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="20dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        app:srcCompat="@mipmap/detail_more"/>
</RelativeLayout>
