<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="480dp">
            <com.google.android.gms.ads.nativead.MediaView
                android:layout_gravity="center"
                android:id="@+id/contentad_media_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"/>
            <TextView
                android:textSize="8sp"
                android:textColor="#ffffff"
                android:layout_gravity="top|left"
                android:background="#ffcc66"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admob_ad_attribution"
                android:height="15dp"
                android:width="15dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_tt"
            android:background="#ffffff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_alignParentBottom="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <ImageView
                    android:id="@+id/contentad_logo"
                    android:padding="6dp"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginLeft="12dp"
                    android:adjustViewBounds="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#787878"
                    android:id="@+id/contentad_headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_toRightOf="@+id/contentad_logo"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@+id/contentad_logo"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#787878"
                    android:id="@+id/contentad_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_toRightOf="@+id/contentad_logo"
                    android:layout_below="@+id/contentad_headline"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@+id/contentad_logo"/>
            </RelativeLayout>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/contentad_call_to_action"
                android:background="@drawable/btn_native_card_ad_call_to_action_2"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="8dp"/>
        </LinearLayout>
    </RelativeLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
